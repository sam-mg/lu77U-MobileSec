            "title": "Sensitive data leak via unprotected implicit broadcast",
            "severity": "Medium",
            "cvss_vector": "AV:L/AC:L/PR:N/UI:N/S:U/C:L/I:N/A:N",
            "cvss_score": 4.0,
            "description": "The app sends an implicit broadcast with the action 'santos.cs.ksu.edu.benign.MyReceiver' containing a phone number in the 'phone' extra. Since the broadcast is implicit and does not specify a target package or require a permission, any application installed on the device can register a receiver for this action and intercept the phone number.",
            "file": "sources/edu/ksu/cs/benign/MainActivity.java",
            "location": "sources/edu/ksu/cs/benign/MainActivity.java:14-17",
            "line": 14,
            "line_start": 14,
            "line_end": 17,
            "impact": "An attacker-controlled app on the same device can leak the user's phone number.",
